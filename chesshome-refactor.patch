-let statsCache = { ts: 0, data: null, pending: null };
-
-app.get('/api/stats', async (req, res) => {
-  try {
-    if (statsCache.data && Date.now() - statsCache.ts < STATS_TTL_MS) return res.json(statsCache.data);
