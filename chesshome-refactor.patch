+// ═══════════════════════════════════════════════════════════════
+//  routes/auth.js — регистрация, вход, аккаунт
+// ═══════════════════════════════════════════════════════════════
+//  Вынесено из монолитного routes.js в рамках рефакторинга.
+//  Код маршрутов не изменён — только обёртка-регистратор.
+
+const {
+  bcrypt,
+  jwt,
+  uuidv4,
+  db,
+  withTransaction,
+  nickHasBadWord,
+  normForSimilarity,
+  app,
+  AUTH_COOKIE_OPTS,
+  limiterAuth,
+  limiterRegStrict,
+  bannedDevices,
+  usersCache,
+  rowToUser,
+  getUser,
+  saveUser,
+  JWT_SECRET,
+  RESERVED,
+  onlineUsers,
+  ipBanMiddleware,
+  getIP,
+  isLocalIP,
+  isVpnOrProxy,
+  rateLimit,
+  loginFailStreaks,
+  getLoginFailStreak,
+  getUsernameLockUntil,
